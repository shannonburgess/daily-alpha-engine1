//@version=6
indicator("Daily Alpha Agentic MU 15M Context Sensor V1", shorttitle="DA-MU-15M-CTX-V1", overlay=true)

// Separate PAPER-only sensor for issue #257. This script emits context evidence only.
// It does not place orders and does not alter SH24/SH25 swing logic.

groupSensor = "Agentic Intraday V1 Sensor"
enableAlerts = input.bool(false, "Enable sensor alert() messages", group=groupSensor)
webhookSecret = input.string("", "Intraday webhook secret", group=groupSensor)
sectorProxy = input.symbol("AMEX:SOXX", "MU sector proxy", group=groupSensor)

isMu = syminfo.ticker == "MU"
is15m = timeframe.isminutes and timeframe.multiplier == 15
inRegularSession = not na(time(timeframe.period, "0930-1600", "America/New_York"))

vwapValue = ta.vwap(hlc3)
ema9 = ta.ema(close, 9)
ema20 = ta.ema(close, 20)

sectorClose = request.security(sectorProxy, timeframe.period, close, lookahead=barmerge.lookahead_off)
sectorPrev = request.security(sectorProxy, timeframe.period, close[1], lookahead=barmerge.lookahead_off)
sectorEma9 = request.security(sectorProxy, timeframe.period, ta.ema(close, 9), lookahead=barmerge.lookahead_off)
sectorEma20 = request.security(sectorProxy, timeframe.period, ta.ema(close, 20), lookahead=barmerge.lookahead_off)

muReturn = close[1] > 0 ? close / close[1] - 1.0 : 0.0
sectorReturn = sectorPrev > 0 ? sectorClose / sectorPrev - 1.0 : 0.0
relativeStrengthPct = (muReturn - sectorReturn) * 100.0

context15mApproved = close > vwapValue and ema9 > ema20 and relativeStrengthPct > 0
sectorContextApproved = sectorClose > sectorEma9 and sectorEma9 > sectorEma20

barTimeIso = str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")
observationId = syminfo.ticker + "-15M-" + str.tostring(time_close)

payload = "{\"webhook_secret\":\"" + webhookSecret + "\",\"sensor_schema\":\"2026-08-21-agentic-intraday-sensor-v1\",\"account_id\":\"PAPER_AGENTIC_INTRADAY_V1\",\"symbol\":\"" + syminfo.ticker + "\",\"sensor_type\":\"CONTEXT_15M\",\"timeframe\":\"15M\",\"observation_id\":\"" + observationId + "\",\"observed_at\":\"" + barTimeIso + "\",\"close\":" + str.tostring(close) + ",\"vwap\":" + str.tostring(vwapValue) + ",\"ema9\":" + str.tostring(ema9) + ",\"ema20\":" + str.tostring(ema20) + ",\"relative_strength_pct\":" + str.tostring(relativeStrengthPct) + ",\"context_15m_approved\":" + str.tostring(context15mApproved) + ",\"sector_context_approved\":" + str.tostring(sectorContextApproved) + ",\"requires_server_enrichment\":true,\"trading_authorized\":false,\"live_trading_enabled\":false}"

emit = barstate.isconfirmed and isMu and is15m and inRegularSession
if enableAlerts and emit
    alert(payload, alert.freq_once_per_bar_close)

plot(vwapValue, "VWAP", color=color.new(color.blue, 0), linewidth=2)
plot(ema9, "EMA 9", color=color.new(color.teal, 0), linewidth=1)
plot(ema20, "EMA 20", color=color.new(color.orange, 0), linewidth=1)
bgcolor(not isMu or not is15m ? color.new(color.red, 88) : context15mApproved and sectorContextApproved ? color.new(color.green, 92) : color.new(color.yellow, 94))
