//@version=6
indicator("Daily Alpha Agentic MU 2M Opening Sensor V1", shorttitle="DA-MU-2M-OPEN-V1", overlay=true)

// Separate PAPER-only raw sensor for issue #257. The backend remains authoritative
// for Daily Alpha context, macro/event risk, portfolio risk and PAPER execution.

groupSensor = "Agentic Intraday V1 Sensor"
enableAlerts = input.bool(false, "Enable sensor alert() messages", group=groupSensor)
webhookSecret = input.string("", "Intraday webhook secret", group=groupSensor)
sectorProxy = input.symbol("AMEX:SOXX", "MU sector proxy", group=groupSensor)

isMu = syminfo.ticker == "MU"
is2m = timeframe.isminutes and timeframe.multiplier == 2
inSession = not na(time(timeframe.period, "0930-1600", "America/New_York"))
openingRangeWindow = not na(time(timeframe.period, "0930-0936", "America/New_York"))
openingExecutionWindow = not na(time(timeframe.period, "0936-1000", "America/New_York"))
newSession = inSession and not nz(inSession[1], false)

var float openingRangeHigh = na
if newSession
    openingRangeHigh := na
if openingRangeWindow
    openingRangeHigh := na(openingRangeHigh) ? high : math.max(openingRangeHigh, high)

openingRangeEstablished = openingExecutionWindow and not na(openingRangeHigh)
vwapValue = ta.vwap(hlc3)
priorVolumeMean20 = ta.sma(volume, 20)[1]
relativeVolume = priorVolumeMean20 > 0 ? volume / priorVolumeMean20 : 0.0
averageDailyShareVolume = request.security(syminfo.tickerid, "D", ta.sma(volume, 30)[1], lookahead=barmerge.lookahead_off)

sectorClose = request.security(sectorProxy, timeframe.period, close, lookahead=barmerge.lookahead_off)
sectorPrev = request.security(sectorProxy, timeframe.period, close[1], lookahead=barmerge.lookahead_off)
muReturn = close[1] > 0 ? close / close[1] - 1.0 : 0.0
sectorReturn = sectorPrev > 0 ? sectorClose / sectorPrev - 1.0 : 0.0
relativeStrengthPct = (muReturn - sectorReturn) * 100.0

barTimeIso = str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")
observationId = syminfo.ticker + "-2M-" + str.tostring(time_close)

payload = "{\"webhook_secret\":\"" + webhookSecret + "\",\"sensor_schema\":\"2026-08-21-agentic-intraday-sensor-v1\",\"account_id\":\"PAPER_AGENTIC_INTRADAY_V1\",\"symbol\":\"" + syminfo.ticker + "\",\"sensor_type\":\"OPENING_2M\",\"timeframe\":\"2M\",\"observation_id\":\"" + observationId + "\",\"observed_at\":\"" + barTimeIso + "\",\"close\":" + str.tostring(close) + ",\"high\":" + str.tostring(high) + ",\"low\":" + str.tostring(low) + ",\"vwap\":" + str.tostring(vwapValue) + ",\"relative_volume\":" + str.tostring(relativeVolume) + ",\"relative_strength_pct\":" + str.tostring(relativeStrengthPct) + ",\"average_daily_share_volume\":" + str.tostring(averageDailyShareVolume) + ",\"opening_range_established\":" + str.tostring(openingRangeEstablished) + ",\"opening_range_high\":" + str.tostring(openingRangeHigh) + ",\"requires_server_enrichment\":true,\"trading_authorized\":false,\"live_trading_enabled\":false}"

emit = barstate.isconfirmed and isMu and is2m and openingRangeEstablished
if enableAlerts and emit
    alert(payload, alert.freq_once_per_bar_close)

plot(vwapValue, "VWAP", color=color.new(color.blue, 0), linewidth=2)
plot(openingRangeHigh, "Opening Range High", color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)
bgcolor(not isMu or not is2m ? color.new(color.red, 88) : openingExecutionWindow ? color.new(color.green, 94) : color.new(color.gray, 96))
